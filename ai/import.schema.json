{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://occamsgarage.com/jobfill/import.schema.json",
  "title": "jobfill interchange document",
  "description": "One JSON format for import, export, and the AI import skill's output (SPEC §9.1). Ids are optional everywhere: the importer assigns UUIDs and resolves defaultVariantId by position.",
  "type": "object",
  "required": ["schemaVersion", "profile"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "profile": { "$ref": "#/$defs/profile" },
    "work": { "type": "array", "items": { "$ref": "#/$defs/workExperience" } },
    "education": { "type": "array", "items": { "$ref": "#/$defs/education" } },
    "projects": { "type": "array", "items": { "$ref": "#/$defs/project" } },
    "certifications": { "type": "array", "items": { "$ref": "#/$defs/certification" } },
    "answers": { "type": "array", "items": { "$ref": "#/$defs/answerEntry" } },
    "versions": { "type": "array", "items": { "$ref": "#/$defs/resumeVersion" } },
    "files": { "type": "array", "items": { "$ref": "#/$defs/interchangeFile" } }
  },
  "$defs": {
    "yearMonth": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
      "description": "\"2021-05\"; day precision is not modeled."
    },
    "variant": {
      "type": "object",
      "required": ["style", "text"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "style": {
          "type": "string",
          "minLength": 1,
          "description": "impact | responsibilities | short | long | any custom label"
        },
        "text": { "type": "string" }
      }
    },
    "snippet": {
      "type": "object",
      "required": ["variants"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "variants": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/variant" } },
        "defaultVariantId": { "type": "string" }
      }
    },
    "profile": {
      "type": "object",
      "required": ["identity", "contact"],
      "additionalProperties": false,
      "properties": {
        "identity": {
          "type": "object",
          "required": ["firstName", "lastName"],
          "additionalProperties": false,
          "properties": {
            "firstName": { "type": "string", "minLength": 1 },
            "lastName": { "type": "string", "minLength": 1 },
            "middleName": { "type": "string" },
            "preferredName": { "type": "string" },
            "honorific": { "type": "string" },
            "suffix": { "type": "string" }
          }
        },
        "contact": {
          "type": "object",
          "required": ["email", "phone"],
          "additionalProperties": false,
          "properties": {
            "email": { "type": "string", "format": "email" },
            "secondaryEmail": { "type": "string", "format": "email" },
            "phone": {
              "type": "object",
              "required": ["countryCode", "national"],
              "additionalProperties": false,
              "properties": {
                "countryCode": { "type": "string" },
                "national": { "type": "string" }
              }
            },
            "phoneType": { "enum": ["mobile", "home", "work"] }
          }
        },
        "address": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "line1": { "type": "string" },
            "line2": { "type": "string" },
            "city": { "type": "string" },
            "state": { "type": "string" },
            "postalCode": { "type": "string" },
            "country": { "type": "string" }
          }
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "linkedin": { "type": "string", "format": "uri" },
            "github": { "type": "string", "format": "uri" },
            "portfolio": { "type": "string", "format": "uri" },
            "website": { "type": "string", "format": "uri" },
            "other": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["label", "url"],
                "additionalProperties": false,
                "properties": {
                  "label": { "type": "string" },
                  "url": { "type": "string", "format": "uri" }
                }
              }
            }
          }
        },
        "summary": { "$ref": "#/$defs/snippet" },
        "coverLetter": { "$ref": "#/$defs/snippet" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "languages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": { "name": { "type": "string" }, "level": { "type": "string" } }
          }
        }
      }
    },
    "workExperience": {
      "type": "object",
      "required": ["company", "title", "startDate"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "company": { "type": "string", "minLength": 1 },
        "companyUrl": { "type": "string", "format": "uri" },
        "location": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "titleVariants": { "type": "array", "items": { "$ref": "#/$defs/variant" } },
        "startDate": { "$ref": "#/$defs/yearMonth" },
        "endDate": { "$ref": "#/$defs/yearMonth" },
        "current": { "type": "boolean" },
        "summary": { "$ref": "#/$defs/snippet" },
        "bullets": { "type": "array", "items": { "$ref": "#/$defs/snippet" } },
        "skills": { "type": "array", "items": { "type": "string" } }
      }
    },
    "education": {
      "type": "object",
      "required": ["school"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "school": { "type": "string", "minLength": 1 },
        "degree": { "type": "string" },
        "field": { "type": "string" },
        "gpa": { "type": "string" },
        "location": { "type": "string" },
        "startDate": { "$ref": "#/$defs/yearMonth" },
        "endDate": { "$ref": "#/$defs/yearMonth" },
        "current": { "type": "boolean" },
        "notes": { "$ref": "#/$defs/snippet" }
      }
    },
    "project": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "startDate": { "$ref": "#/$defs/yearMonth" },
        "endDate": { "$ref": "#/$defs/yearMonth" },
        "summary": { "$ref": "#/$defs/snippet" },
        "bullets": { "type": "array", "items": { "$ref": "#/$defs/snippet" } },
        "skills": { "type": "array", "items": { "type": "string" } }
      }
    },
    "certification": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "issuer": { "type": "string" },
        "date": { "$ref": "#/$defs/yearMonth" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "answerEntry": {
      "type": "object",
      "required": ["question", "kind", "value"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "key": {
          "enum": [
            "workAuthorization",
            "sponsorship",
            "relocation",
            "remotePreference",
            "salaryExpectation",
            "noticePeriod",
            "earliestStart",
            "howDidYouHear",
            "referralName",
            "over18",
            "previouslyEmployedHere",
            "criminalDisclosure",
            "gender",
            "race",
            "ethnicity",
            "veteranStatus",
            "disabilityStatus",
            "pronouns"
          ]
        },
        "question": { "type": "string", "minLength": 1 },
        "patterns": { "type": "array", "items": { "type": "string" } },
        "kind": { "enum": ["boolean", "choice", "text", "number", "date"] },
        "value": { "type": ["string", "number", "boolean"] },
        "choiceSynonyms": { "type": "array", "items": { "type": "string" } },
        "variants": { "type": "array", "items": { "$ref": "#/$defs/variant" } },
        "sensitive": { "type": "boolean" }
      }
    },
    "resumeVersion": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "fileId": { "type": "string" },
        "coverLetterFileId": { "type": "string" },
        "include": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "workIds": { "type": "array", "items": { "type": "string" } },
            "educationIds": { "type": "array", "items": { "type": "string" } },
            "projectIds": { "type": "array", "items": { "type": "string" } },
            "certificationIds": { "type": "array", "items": { "type": "string" } },
            "skills": { "type": "array", "items": { "type": "string" } }
          }
        },
        "stylePriority": { "type": "array", "items": { "type": "string" } },
        "variantPrefs": { "type": "object", "additionalProperties": { "type": "string" } },
        "titlePrefs": { "type": "object", "additionalProperties": { "type": "string" } },
        "answerOverrides": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        }
      }
    },
    "interchangeFile": {
      "type": "object",
      "required": ["kind", "name", "mime", "base64"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["resume", "coverLetter", "other"] },
        "name": { "type": "string", "minLength": 1 },
        "mime": { "type": "string", "minLength": 1 },
        "base64": { "type": "string", "contentEncoding": "base64" }
      }
    }
  }
}
